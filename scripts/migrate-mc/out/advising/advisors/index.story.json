          "partial_background": true,
          "text_location": "jumbotron-content-bottom-left",
          "height": "300px",
          "container_width": "default",
          "header": "USU's Advising Structure"
        },
        {
          "_uid": "3d5b7c55-10fe-49b7-ba7b-a341cdb1957d",
          "component": "moca-container",
          "width": "default",
          "margin_y": "5",
          "padding_y": "",
          "content": [
            {
              "_uid": "75bd87a1-41bd-4760-b782-b39c581e41b0",
              "component": "moca-text",
              "text": {
                "type": "doc",
                "content": [
                  {
                    "type": "paragraph",
                    "attrs": {
                      "textAlign": null
                    },
                    "content": [
                      {
                        "type": "text",
                        "text": "The advising structure is coordinated system-wide and is focused on supporting student success through academic advising. "
                      },
                      {
                        "type": "text",
                        "marks": [
                          {
                            "type": "link",
                            "attrs": {
                              "href": "https://www.usu.edu/advising/advisors/advising-guide",
                              "uuid": null,
                              "anchor": null,
                              "target": null,
                              "linktype": "url",
                              "custom": {}
                            }
                          }
                        ],
                        "text": "The Advising Guide"
                      },
                      {
                        "type": "text",
                        "text": " provides student and advisor responsibilities to guide the academic advising experience."
                      }
                    ]
                  }
                ]
              },
              "style": "lead"
            },
            {
              "_uid": "4d199e8c-fd06-4f81-b5e7-4a2a6ee6873a",
              "component": "moca-text",
              "text": {
                "type": "doc",
                "content": [
                  {
                    "type": "paragraph",
                    "attrs": {
                      "textAlign": null
                    },
                    "content": [
                      {
                        "type": "text",
                        "text": "Academic advisors are supported through "
                      },
                      {
                        "type": "text",
                        "marks": [
                          {
                            "type": "link",
                            "attrs": {
                              "href": "https://www.usu.edu/advising/advisors/professional-development",
                              "uuid": null,
                              "anchor": null,
                              "target": null,
                              "linktype": "url",
                              "custom": {}
                            }
                          }
                        ],
                        "text": "professional development opportunities"
                      },
                      {
                        "type": "text",
                        "text": " and coordinated strategies to achieve an excellent advising experience for all students. USU academic advisors are trained in the assets-based "
                      },
                      {
                        "type": "text",
                        "marks": [
                          {
                            "type": "link",
                            "attrs": {
                              "href": "https://www.appreciativeadvising.net/",
                              "uuid": null,
                              "anchor": null,
                              "target": null,
                              "linktype": "url",
                              "custom": {}
                            }
                          }
                        ],
                        "text": "Appreciative Advising framework."
                      }
                    ]
                  }
                ]
              },
              "style": "lead"
            },
            {
              "_uid": "32a4168a-174a-42dd-bf3a-bd553d6a10e1",
              "component": "moca-text",
              "text": {
                "type": "doc",
                "content": [
                  {
                    "type": "paragraph",
                    "attrs": {
                      "textAlign": null
                    },
                    "content": [
                      {
                        "type": "text",
                        "text": "USU designs, maintains, and evaluates a systemic and effective program of academic advisement to support student development and success. Advisors are knowledgeable of the curriculum, program, and graduation requirements, and are adequately prepared to successfully fulfill their responsibilities. Advising requirements and responsibilities of advisors are defined, published, and made available to students. ("
                      },
                      {
                        "type": "text",
                        "marks": [
                          {
                            "type": "link",
                            "attrs": {
                              "href": "https://www.usu.edu/advising/advisors/advising-guide",
                              "uuid": null,
                              "anchor": null,
                              "target": "_blank",
                              "linktype": "url",
                              "custom": {
                                "title": "advising guide",
                                "rel": "noopener"
                              }
                            }
                          }
                        ],
                        "text": "advising syllabus"
                      },
                      {
                        "type": "text",
                        "text": ")"
                      }
                    ]
                  }
                ]
              },
              "style": "lead"
            },
            {
              "_uid": "b27f9298-1e0c-48d4-98fa-ffa0bda8f404",
              "component": "moca-heading",
              "text": "Advising Leadership",
              "level": "h2",
              "color": "",
              "align": "",
              "bold": false,
              "margin_top": "",
              "margin_bottom": "",
              "anchor": "leadership"
            },
            {
              "_uid": "c57c692c-1563-4123-9753-b7ce37b250fb",
              "component": "moca-text",
              "text": {
                "type": "doc",
                "content": [
                  {
                    "type": "paragraph",
                    "attrs": {
                      "textAlign": null
                    },
                    "content": [
                      {
                        "type": "text",
                        "text": "Academic advising at Utah State University is guided by University Advising, Advising Administrators, and the Council of Lead Advisors (CLA). In partnership, these groups develop strategies to provide an advising environment that supports a holistic advising experience where students are developmentally supported in achieving their goals."
                      }
                    ]
                  },
                  {
                    "type": "paragraph",
                    "attrs": {
                      "textAlign": null
                    },
                    "content": [
                      {
                        "type": "text",
                        "marks": [
                          {
                            "type": "bold"
                          }
                        ],
                        "text": "The Council of Lead Advisors"
                      },
                      {
                        "type": "text",
                        "text": " includes a representative from each of the advising units and statewide campuses. This group provides key information regarding student-facing processes and trends. "
                      },
                      {
                        "type": "text",
                        "marks": [
                          {
                            "type": "bold"
                          }
                        ],
                        "text": "Advising Administrators"
                      },
                      {
                        "type": "text",
                        "text": " are leaders of advising units and are responsible for guiding the work of individuals and teams. They are able to support advising best practices within their units. "
                      },
                      {
                        "type": "text",
                        "marks": [
                          {
                            "type": "bold"
                          }
                        ],
                        "text": "The Office of University Advising"
                      },
                      {
                        "type": "text",
                        "text": " is responsible for the coordination of USU's advising system."
                      }
                    ]
                  }
                ]
              }
            },
