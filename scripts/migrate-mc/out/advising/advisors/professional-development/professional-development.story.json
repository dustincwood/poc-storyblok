                                          "href": "https://usu.instructure.com/",
                                          "uuid": null,
                                          "anchor": null,
                                          "target": null,
                                          "linktype": "url",
                                          "custom": {}
                                        }
                                      }
                                    ],
                                    "text": "University Advising Academy"
                                  }
                                ]
                              },
                              {
                                "type": "paragraph",
                                "attrs": {
                                  "textAlign": null
                                },
                                "content": [
                                  {
                                    "type": "text",
                                    "text": " "
                                  }
                                ]
                              },
                              {
                                "type": "paragraph",
                                "attrs": {
                                  "textAlign": null
                                },
                                "content": [
                                  {
                                    "type": "text",
                                    "text": "Utah State University's advising system is a collaborative structure that works to ensure that all students receive excellent advising across the statewide system. The University Advising Academy starts by supporting new advisors and the current advising community with asynchronous foundational resources for advising practice at USU. These trainings are linked to the NACADA Core Competencies for Academic Advising."
                                  }
                                ]
                              },
                              {
                                "type": "paragraph",
                                "attrs": {
                                  "textAlign": null
                                },
                                "content": [
                                  {
                                    "type": "text",
                                    "text": "The program continues to support advisor growth and development through the Advising Excellence badging program. Participation in the badging program culminates in a yearly certificate.  This certificate is for academic advisors at USU who want to engage in a structured professional development plan during the academic year. The certificate program is guided by NACADA Core Competencies. "
                                  }
                                ]
                              },
                              {
                                "type": "paragraph",
                                "attrs": {
                                  "textAlign": null
                                },
                                "content": [
                                  {
                                    "type": "text",
                                    "text": "The Canvas course is managed by University Advising: "
                                  }
