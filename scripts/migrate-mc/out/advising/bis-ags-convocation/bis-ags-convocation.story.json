                                        "marks": [
                                          {
                                            "type": "bold"
                                          }
                                        ],
                                        "text": "Time:"
                                      },
                                      {
                                        "type": "text",
                                        "text": " 9:00 - 10:30 a.m."
                                      },
                                      {
                                        "type": "hard_break"
                                      },
                                      {
                                        "type": "text",
                                        "marks": [
                                          {
                                            "type": "bold"
                                          }
                                        ],
                                        "text": "Location:"
                                      },
                                      {
                                        "type": "text",
                                        "text": " Newel & Jean Daines Concert Hall"
                                      },
                                      {
                                        "type": "hard_break"
                                      }
                                    ]
                                  },
                                  {
                                    "type": "bullet_list",
                                    "content": [
                                      {
