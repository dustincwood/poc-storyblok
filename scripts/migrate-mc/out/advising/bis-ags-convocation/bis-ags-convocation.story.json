                        {
                          "_uid": "943875b4-a9de-409b-8919-251b24bb9a00",
                          "component": "moca-heading",
                          "text": "Bachelor of Integrated Studies and Associate of General Studies Convocation",
                          "level": "h1",
                          "color": "",
                          "align": "",
                          "bold": false,
                          "margin_bottom": "",
                          "anchor": ""
                        },
                        {
                          "_uid": "5d815f44-7c64-4acb-9735-6a9f4ef61b52",
                          "component": "moca-text",
                          "text": {
                            "type": "doc",
                            "content": [
                              {
                                "type": "paragraph",
                                "attrs": {
                                  "textAlign": null
                                },
                                "content": [
                                  {
                                    "type": "text",
                                    "text": "Students who graduate in Summer, Fall, or Spring are invited to participate in the Spring graduation ceremonies which include the "
                                  },
                                  {
                                    "type": "text",
                                    "marks": [
                                      {
                                        "type": "link",
                                        "attrs": {
                                          "href": "https://www.usu.edu/commencement/index.php",
                                          "uuid": null,
                                          "anchor": null,
                                          "target": null,
                                          "linktype": "url",
                                          "custom": {}
                                        }
                                      }
                                    ],
                                    "text": "University commencement"
                                  },
                                  {
                                    "type": "text",
                                    "text": " and college convocations. The Commencement Ceremony will include the traditional walk from the quad to the Spectrum where there will be the awarding of honorary degrees, announcement of university-wide faculty awards, Commencement speeches, and the conferring of degrees upon all graduates. At the convocation ceremony, your name is read and you \"walk\" up to be recognized, receive a diploma cover, and have a professional photo taken."
                                  }
                                ]
                              }
                            ]
                          },
                          "style": "lead"
                        },
                        {
                          "_uid": "8caa68f1-4548-461d-88cd-34f2de46c868",
                          "component": "moca-text",
                          "text": {
                            "type": "doc",
                            "content": [
                              {
                                "type": "paragraph",
                                "attrs": {
                                  "textAlign": null
                                },
                                "content": [
                                  {
                                    "type": "text",
                                    "text": "Please note the university commencement ceremony and the convocation ceremony are \"clear bag\" events. Guests should use clear bags or transparent containers to carry their belongings, for the safety of all attendees."
                                  }
                                ]
                              }
                            ]
                          },
                          "style": "lead"
                        },
