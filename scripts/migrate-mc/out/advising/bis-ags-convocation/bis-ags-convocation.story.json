                                          {
                                            "type": "bold"
                                          }
                                        ],
                                        "text": "Date:"
                                      },
                                      {
                                        "type": "text",
                                        "text": " Thursday, April 30"
                                      },
                                      {
                                        "type": "hard_break"
                                      },
                                      {
