          },
          {
            "name": "Danger",
            "value": "btn-danger"
          },
          {
            "name": "Secondary",
            "value": "btn-secondary"
          },
          {
            "name": "Light",
            "value": "btn-light"
          },
          {
            "name": "Dark",
            "value": "btn-dark"
          },
          {
            "name": "Link",
            "value": "btn-link"
          },
          {
            "name": "Blue",
            "value": "btn-blue"
          },
          {
            "name": "Bright Light",
            "value": "btn-bright-light"
          },
          {
            "name": "Green",
            "value": "btn-green"
          },
          {
            "name": "Sage",
            "value": "btn-sage"
          },
          {
            "name": "Sand",
            "value": "btn-sand"
          },
          {
            "name": "Blue Dark",
            "value": "btn-blue-dark"
          }
        ],
        "default_value": "btn-white"
      },
      "outline": {
        "pos": 3,
        "type": "boolean"
      },
      "size": {
        "pos": 4,
        "type": "option",
        "options": [
          {
            "name": "Small",
            "value": "btn-sm"
          },
          {
            "name": "Large",
            "value": "btn-lg"
          }
        ]
      },
      "centered": {
        "pos": 5,
        "type": "boolean"
      }
    }
  },
