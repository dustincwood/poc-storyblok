[
  {
    "name": "moca-accordion",
    "display_name": "MC Accordion / Tabs",
    "is_root": false,
    "is_nestable": true,
    "schema": {
      "display": {
        "pos": 0,
        "type": "option",
        "options": [
          {
            "name": "Accordion",
            "value": "accordion"
          },
          {
            "name": "Tabs",
            "value": "tabs"
          },
          {
            "name": "Pills",
            "value": "pills"
          }
        ],
        "default_value": "accordion"
      },
      "panels": {
        "pos": 1,
        "type": "bloks",
        "restrict_components": true,
        "component_whitelist": [
          "moca-accordion-panel"
        ],
        "maximum": 15
      }
    }
  },
